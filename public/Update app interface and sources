        <h2>登录模拟账户</h2>
        <p>这是你的云端模拟炒股训练场，输入部署时设置的访问密码。</p>
        <input id="passwordInput" type="password" autocomplete="current-password" placeholder="访问密码" />
        <button class="primary" type="submit">进入</button>
        <p id="loginMessage" class="message"></p>
      </form>
    </section>

    <header class="topbar">
      <div>
        <p class="eyebrow">Paper Trading Lab</p>
        <h1>模拟炒股训练场</h1>
      </div>
      <div class="market-pills">
        <button id="logoutBtn" class="pill button-pill" hidden>退出</button>
        <span id="statusA" class="pill">A股</span>
        <span id="statusUS" class="pill">美股</span>
      </div>
    </header>

    <main class="shell">
      <section class="summary-grid" aria-label="账户概览">
        <article class="metric">
          <span>总资产估算</span>
          <strong id="totalAsset">--</strong>
        </article>
        <article class="metric">
          <span>人民币现金</span>
          <strong id="cashCny">--</strong>
        </article>
        <article class="metric">
          <span>美元现金</span>
          <strong id="cashUsd">--</strong>
        </article>
        <article class="metric">
          <span>持仓盈亏</span>
          <strong id="totalPnl">--</strong>
        </article>
      </section>

      <section class="workspace">
        <nav class="tabs" aria-label="页面切换">
          <button class="tab active" data-tab="watch">自选</button>
          <button class="tab" data-tab="chart">图表</button>
          <button class="tab" data-tab="trade">交易</button>
          <button class="tab" data-tab="positions">持仓</button>
          <button class="tab" data-tab="account">账户</button>
          <button class="tab" data-tab="sources">数据</button>
          <button class="tab" data-tab="journal">复盘</button>
        </nav>

        <section id="watch" class="panel active">
          <div class="panel-head">
            <div>
              <h2>自选行情</h2>
              <p id="dataSource">正在读取行情...</p>
            </div>
            <button id="refreshBtn" class="icon-btn" title="刷新行情">↻</button>
          </div>
          <div id="quoteList" class="quote-list"></div>
        </section>

        <section id="chart" class="panel">
          <div class="panel-head">
            <div>
              <h2 id="chartTitle">行情图表</h2>
              <p id="chartMeta">K 线：一根柱子代表一段时间的开盘、最高、最低、收盘。</p>
            </div>
            <div class="actions">
              <select id="chartSymbol"></select>
              <select id="chartRange">
                <option value="1d">日内</option>
                <option value="1mo" selected>近1月</option>
                <option value="3mo">近3月</option>
                <option value="1y">近1年</option>
              </select>
            </div>
          </div>
          <div class="chart-layout">
            <div class="chart-card">
              <canvas id="klineCanvas" width="960" height="420"></canvas>
            </div>
