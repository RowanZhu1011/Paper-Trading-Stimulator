            <label>
              类型
              <select id="typeInput">
                <option value="market">市价</option>
                <option value="limit">限价</option>
              </select>
            </label>
            <label>
              限价
              <input id="limitInput" type="number" step="0.001" placeholder="市价可留空" />
            </label>
            <label>
              数量
              <input id="quantityInput" type="number" min="1" value="100" />
            </label>
            <label class="wide">
              下单理由
              <textarea id="reasonInput" rows="3" placeholder="例如：观察沪深300ETF回到20日均线附近，先用小仓位练习限价买入。"></textarea>
            </label>
            <button class="primary wide" type="submit">提交模拟订单</button>
          </form>
          <p id="orderMessage" class="message"></p>
        </section>

        <section id="positions" class="panel">
          <div class="panel-head">
            <div>
              <h2>持仓</h2>
              <p>浮盈亏会随行情刷新变化。</p>
            </div>
            <div class="actions">
              <button id="rolloverBtn" class="secondary">模拟到下一交易日</button>
              <button id="resetBtn" class="secondary danger">重置账户</button>
            </div>
          </div>
          <div id="positionList" class="table-like"></div>
          <h3>最近订单</h3>
          <div id="orderList" class="history"></div>
        </section>

        <section id="account" class="panel">
          <div class="panel-head">
            <div>
              <h2>模拟开户与资金</h2>
              <p>按真实账户思路拆成 A 股账户和美股账户，费用参数可调整。</p>
            </div>
          </div>
          <div class="account-grid">
            <article class="account-card">
              <span>A股模拟账户</span>
              <strong id="accountAStatus">已开通</strong>
              <p>人民币资金，100 股一手，模拟 T+1、涨跌停和 A 股交易费用。</p>
            </article>
            <article class="account-card">
              <span>美股模拟账户</span>
              <strong id="accountUSStatus">已开通</strong>
              <p>美元资金，1 股起买，暂不模拟盘前盘后和融资融券。</p>
            </article>
          </div>
          <form id="depositForm" class="order-form">
            <label>
              入金币种
              <select id="depositCurrency">
                <option value="CNY">人民币</option>
                <option value="USD">美元</option>
              </select>
            </label>
            <label>
              模拟入金金额
              <input id="depositAmount" type="number" min="1" step="100" value="10000" />
            </label>
            <button class="primary wide" type="submit">模拟入金</button>
          </form>
          <h3>交易费用参数</h3>
          <form id="settingsForm" class="settings-grid">
            <label>A股佣金率<input id="aCommissionRate" type="number" step="0.00001" /></label>
            <label>A股最低佣金<input id="aMinCommission" type="number" step="0.01" /></label>
            <label>A股卖出印花税<input id="aStampDutyRate" type="number" step="0.0001" /></label>
            <label>A股过户费<input id="aTransferRate" type="number" step="0.00001" /></label>
            <label>美股佣金率<input id="usCommissionRate" type="number" step="0.00001" /></label>
            <label>美股最低佣金<input id="usMinCommission" type="number" step="0.01" /></label>
            <label>美元人民币估算汇率<input id="usdToCny" type="number" step="0.01" /></label>
            <button class="primary" type="submit">保存费用参数</button>
          </form>
          <p id="accountMessage" class="message"></p>
        </section>

        <section id="sources" class="panel">
          <div class="panel-head">
            <div>
              <h2>行情数据源</h2>
              <p>系统会按顺序尝试多个免费来源，并在行情和图表上标明实际使用的数据源。</p>
            </div>
          </div>
          <div id="sourceList" class="source-grid"></div>
          <h3>当前自选命中情况</h3>
          <div id="sourceHitList" class="table-like"></div>
        </section>

        <section id="journal" class="panel">
          <div class="panel-head">
            <div>
              <h2>复盘</h2>
              <p>每一笔交易都留下理由，后面才能看见自己的模式。</p>
            </div>
          </div>
          <form id="journalForm" class="journal-form">
            <input id="journalTitle" placeholder="标题，例如：今天为什么想追高" />
            <textarea id="journalContent" rows="4" placeholder="写下观察、情绪、计划和结果。"></textarea>
            <button class="primary" type="submit">保存复盘</button>
          </form>
          <div id="journalList" class="history"></div>
        </section>
      </section>
    </main>

    <footer class="footer">
      这是学习用模拟环境，不构成投资建议。免费行情可能延迟或不可用，系统会自动切换到仿真行情。
    </footer>

    <script src="/app.js"></script>
  </body>
</html>

:root {
  color-scheme: light;
  --paper: #f7f5ef;
  --ink: #17211f;
  --muted: #68736f;
  --line: #d8d2c5;
  --brand: #1c5d54;
  --brand-2: #0f7b72;
  --warn: #b33a3a;
  --gain: #c62828;
  --loss: #168457;
  --gold: #f0b429;
  --white: #fffdf8;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
}

[hidden] {
  display: none !important;
}

button,
input,
select,
textarea {
  font: inherit;
}

.topbar {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  padding: 28px clamp(18px, 4vw, 48px) 18px;
  align-items: flex-end;
  background: #fff9eb;
  border-bottom: 1px solid var(--line);
}

.eyebrow {
  margin: 0 0 4px;
  color: var(--brand);
  font-weight: 700;
  font-size: 0.78rem;
  letter-spacing: 0;
}

h1,
h2,
h3,
p {
  margin: 0;
}

h1 {
  font-size: clamp(1.8rem, 4vw, 3.2rem);
  letter-spacing: 0;
}

h2 {
  font-size: 1.18rem;
}

h3 {
  font-size: 1rem;
  margin: 22px 0 10px;
}

.market-pills {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.pill {
  border: 1px solid var(--line);
  padding: 7px 10px;
  border-radius: 999px;
  background: var(--white);
  color: var(--muted);
  font-size: 0.86rem;
  white-space: nowrap;
}

.button-pill {
  cursor: pointer;
}

.pill.open {
  color: var(--brand);
  border-color: #8bc7bd;
  background: #ecfffb;
}

.login-overlay {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: grid;
  place-items: center;
  padding: 18px;
  background: rgba(247, 245, 239, 0.94);
}

.login-box {
  width: min(420px, 100%);
  display: grid;
  gap: 12px;
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 22px;
  box-shadow: 0 18px 50px rgba(23, 33, 31, 0.12);
}

.login-box p {
  color: var(--muted);
}

.shell {
  width: min(1180px, calc(100% - 28px));
  margin: 18px auto 32px;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 14px;
}

.metric {
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 16px;
  min-height: 92px;
}

.metric span {
  display: block;
  color: var(--muted);
  font-size: 0.9rem;
  margin-bottom: 12px;
}

.metric strong {
  font-size: 1.35rem;
  word-break: break-word;
}

.workspace {
  display: grid;
  grid-template-columns: 142px minmax(0, 1fr);
  gap: 14px;
  align-items: start;
}

.tabs {
  display: grid;
  gap: 8px;
  position: sticky;
  top: 10px;
}

.tab,
.secondary,
.primary,
.icon-btn {
  border: 1px solid var(--line);
  background: var(--white);
  color: var(--ink);
  border-radius: 8px;
  min-height: 42px;
  cursor: pointer;
}

.tab {
  text-align: left;
  padding: 0 14px;
}

.tab.active {
  background: var(--brand);
  color: white;
  border-color: var(--brand);
}

.panel {
  display: none;
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 18px;
  min-height: 560px;
}

.panel.active {
  display: block;
}

.panel-head {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: flex-start;
  margin-bottom: 16px;
}

.panel-head p,
.footer,
.message {
  color: var(--muted);
  font-size: 0.92rem;
  margin-top: 5px;
}

.icon-btn {
  width: 42px;
  font-size: 1.1rem;
}

.secondary {
  padding: 0 12px;
}

.actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.danger {
  color: var(--warn);
  border-color: #e5b2aa;
}

.primary {
  background: var(--brand);
  color: white;
  border-color: var(--brand);
  padding: 0 16px;
  font-weight: 700;
}

.quote-list {
  display: grid;
  gap: 8px;
}

.quote-row,
.position-row,
.history-item {
  display: grid;
  gap: 10px;
  align-items: center;
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 12px;
  background: #fffefa;
}

.quote-row {
  grid-template-columns: minmax(160px, 1.4fr) repeat(4, minmax(88px, 0.7fr)) 136px;
}

.name {
  font-weight: 800;
}

.sub {
  color: var(--muted);
  font-size: 0.82rem;
  margin-top: 3px;
}

.price {
  font-weight: 800;
  font-size: 1.08rem;
}

.gain {
  color: var(--gain);
}

.loss {
  color: var(--loss);
}

.row-actions {
  display: flex;
  gap: 6px;
}

.row-actions button {
  flex: 1;
  padding: 0 8px;
}

.chart-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 260px;
  gap: 14px;
  align-items: stretch;
}

.chart-card {
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fffefa;
  padding: 10px;
  min-height: 420px;
}

#klineCanvas {
  display: block;
  width: 100%;
  height: 420px;
}

.insight-panel,
.account-card {
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fffefa;
  padding: 14px;
}

.insight-panel p,
.account-card p {
  color: var(--muted);
  line-height: 1.55;
  margin-top: 10px;
}

.account-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 16px;
}

.source-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 18px;
}

.source-card {
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fffefa;
  padding: 14px;
}

.source-card p {
  color: var(--muted);
  line-height: 1.5;
  margin-top: 10px;
}

.account-card span {
  color: var(--muted);
  font-size: 0.9rem;
}

.account-card strong {
  display: block;
  margin-top: 8px;
  font-size: 1.25rem;
  color: var(--brand);
}

.order-form {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

label {
  display: grid;
  gap: 6px;
  color: var(--muted);
  font-size: 0.9rem;
}

input,
select,
textarea {
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fffefa;
  color: var(--ink);
  padding: 10px 11px;
  min-width: 0;
}

textarea {
  resize: vertical;
}

.wide {
  grid-column: 1 / -1;
}

.table-like,
.history {
  display: grid;
  gap: 8px;
}

.position-row {
  grid-template-columns: minmax(150px, 1.3fr) repeat(5, minmax(80px, 0.8fr));
}

.history-item {
  grid-template-columns: minmax(130px, 0.8fr) minmax(160px, 1.5fr) minmax(140px, 1fr);
}

.journal-form {
  display: grid;
  gap: 10px;
  margin-bottom: 16px;
}

.settings-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

.empty {
  color: var(--muted);
  padding: 20px 0;
}

.footer {
  width: min(1180px, calc(100% - 28px));
  margin: 0 auto 26px;
}

@media (max-width: 820px) {
  .topbar {
    display: grid;
    align-items: start;
  }

  .market-pills {
    justify-content: flex-start;
  }

  .summary-grid,
  .workspace,
  .order-form,
  .chart-layout,
  .account-grid,
  .settings-grid,
  .source-grid {
    grid-template-columns: 1fr;
  }

  .tabs {
    position: static;
    grid-template-columns: repeat(4, 1fr);
  }

  .tab {
    text-align: center;
    padding: 0 6px;
  }

  .panel {
    padding: 14px;
    min-height: 0;
  }

  .panel-head {
    display: grid;
    align-items: stretch;
  }

  .actions {
    justify-content: stretch;
  }

  .actions button {
    flex: 1;
  }

  .quote-row,
  .position-row,
  .history-item {
    grid-template-columns: 1fr 1fr;
  }

  .quote-row > div:first-child,
  .quote-row > .row-actions,
  .position-row > div:first-child,
  .history-item > div {
    grid-column: 1 / -1;
  }

  .chart-card,
  #klineCanvas {
    min-height: 340px;
    height: 340px;
  }
}

const CACHE = "stock-practice-lab-v5";
const ASSETS = ["/", "/index.html", "/styles.css", "/app.js", "/manifest.json", "/icon.svg"];

self.addEventListener("install", (event) => {
  event.waitUntil(caches.open(CACHE).then((cache) => cache.addAll(ASSETS)));
});

self.addEventListener("fetch", (event) => {
  const url = new URL(event.request.url);
  if (url.pathname.startsWith("/api/")) return;
  event.respondWith(caches.match(event.request).then((cached) => cached || fetch(event.request)));
});
